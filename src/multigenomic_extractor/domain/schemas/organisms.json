{
  "organisms": {
    "validator": {
      "$jsonSchema": {
        "type": "object",
        "required": [
          "_id",
          "name"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^RDB(?:MG[A-Z]{7}[0-9]{7}|[A-Z]{8}[0-9]{5})$"
          },
          "accession": {
            "type": "string"
          },
          "accessionVersion": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "internalComment": {
            "type": "string"
          },
          "genomeVersion": {
            "type": "string"
          },
          "genomeSize": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "pgdbAuthors": {
            "type": "array",
            "uniqueItems": false,
            "items": {
              "type": "string"
            }
          },
          "dbCrossReference": {
            "type": "array",
            "uniqueItems": false,
            "items": {
              "type": "string"
            }
          },
          "pgdbCopyright": {
            "type": "string"
          },
          "pgdbName": {
            "type": "string"
          },
          "sourceFile": {
            "type": "string"
          },
          "strainName": {
            "type": "string"
          },
          "synonyms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "taxonId": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "taxonName": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "plasmidName": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
}